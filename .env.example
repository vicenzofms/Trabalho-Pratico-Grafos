# Configuração do backend (copie para `.env` — que é git-ignored).
# No MVP (cache-only) nenhuma destas variáveis é obrigatória; os defaults bastam.

# Tokens do GitHub separados por vírgula. Usados só na Fase 6 (mineração pela API).
GITHUB_TOKENS=

# Origens permitidas no CORS (origem do front), separadas por vírgula. Ex.:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=*

# Pasta dos caches JSON. Vazio = usa `src/data` (mesma do minerador).
DIRETORIO_DADOS=
